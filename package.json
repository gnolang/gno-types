{
  "name": "@gnolang/gno-types",
  "version": "1.1.0",
  "description": "JS and TS types relating to proto-compatible amino encoding used by gno",
  "contributors": [
    "Alex M.<alex.megalokonomos@tendermint.com>",
    "Milos Zivkovic <milos.zivkovic@tendermint.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnolang/gno-types.git"
  },
  "files": [
    "dist/",
    "*.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc --noEmit && tsdown",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "codegen": "rimraf ./src && ./scripts/generate.sh && ./scripts/addIndices.js && pnpm run lint:fix",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.9.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@bufbuild/protobuf": "^2.13.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "rimraf": "^6.1.3",
    "ts-proto": "^2.12.0",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^5.0.0"
  },
  "keywords": [],
  "author": "Alex M.<alex.megalokonomos@tendermint.com>",
  "license": "Apache-2.0",
  "homepage": "https://gno.land/",
  "packageManager": "pnpm@12.4.2"
}
